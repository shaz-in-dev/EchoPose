# Compiled code
__pycache__/
*.pyc
*.pyo
*.pyd
*.ndarray

# Rust
target/

# Logs and Artifacts
logs/
*.log
*.sqlite
firmware/build/
.env

# Virtual environments
venv/
env/
ENV/

# Local tool state — not shared project config
.claude/

# Runtime-generated data (session DBs, captured CSI, etc.) — not source
inference/data/
data/

# Python packaging artefacts — local builds should never be committed
dist/
build/
*.egg-info/

# Test / coverage artefacts
.coverage
htmlcov/
.pytest_cache/

# Important documents — kept local, never pushed
*.docx
*.doc
*.xlsx
*.pdf

# Node / npm
node_modules/
package-lock.json

# Secrets
*.env.*

#Docs
docs/business/
docs/financial/
docs/legal/

# Trained model checkpoints — real weights are large, hardware/session-specific,
# and must never be shipped by accident. Smoke-test/synthetic checkpoints
# (pose_net.synthetic_smoketest.pt) are intentionally excluded too so nothing
# under models/ is committed silently again.
inference/models/*.pt
inference/models/*.onnx
inference/models/validation_results*.json