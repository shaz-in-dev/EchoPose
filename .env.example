# ==============================================================================
# EchoPose Home Safety Monitor — Configuration
#
# Copy this file to .env  then fill in the sections that apply to you.
# You only NEED to change the Quick Start section to get running.
# Everything else is optional.
# ==============================================================================


# ── QUICK START ───────────────────────────────────────────────────────────────
# Required: choose a strong password to secure the API.
ECHOPOSE_API_TOKEN=change-me-to-a-strong-password

# How many ESP32 sensor nodes you have installed (usually 3)
EXPECTED_NODES=3


# ── ALERT NOTIFICATIONS ───────────────────────────────────────────────────────
# Get instant phone alerts when something important happens:
#   • Fall detected
#   • No movement for several hours (wellness check)
#   • Abnormal heart rate
#   • Person enters or leaves the monitored area
#
# Set at least ONE of the options below.

# ── Option A: Pushover (recommended — free app, instant phone alerts)
#    Sign up at https://pushover.net · Takes 2 minutes
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# ── Option B: Telegram (free, works worldwide)
#    1. Message @BotFather on Telegram to create a bot → get TELEGRAM_BOT_TOKEN
#    2. Message your bot once, then visit:
#       https://api.telegram.org/bot<TOKEN>/getUpdates  to get TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Option C: Any HTTP webhook (IFTTT, Zapier, n8n, Home Assistant, custom)
#    Comma-separated list of URLs to POST JSON alerts to
WEBHOOK_URLS=

# How long without movement before an inactivity alert fires (default: 4 hours)
INACTIVITY_ALERT_MINUTES=240

# Minimum time (seconds) between repeated alerts of the same type (default: 60s)
WEBHOOK_DEBOUNCE_SECONDS=60


# ── SMART HOME INTEGRATION ────────────────────────────────────────────────────

# ── Home Assistant via MQTT (auto-discovers 13 sensors, no YAML needed)
#    Uncomment and set your MQTT broker IP address:
# HA_MQTT_BROKER=192.168.1.10
# HA_MQTT_PORT=1883
# HA_MQTT_USERNAME=
# HA_MQTT_PASSWORD=
# HA_DISCOVERY_PREFIX=homeassistant
# HA_STATE_PREFIX=echopose

# ── Apple Home / Google Home / Amazon Alexa (Matter protocol)
#    Set MATTER_ENABLED=true, then visit http://your-device:8765/matter/pairing
#    Scan the QR code in your smart home app once — pairing is permanent.
# MATTER_ENABLED=true
# MATTER_PORT=5540
# MATTER_PASSCODE=20202021
# MATTER_DISCRIMINATOR=3840
# MATTER_HTTP_PORT=7788
# MATTER_HOST=127.0.0.1       # set to "matter-bridge" when using Docker Compose


# ── FAST ADAPTATION (Pro license feature) ────────────────────────────────────
# Enable LoRA self-supervised adaptation to your specific room layout.
# After 30 seconds of buffering, call POST /adapt to tune the model.
# LORA_ADAPT=true
# LORA_RANK=8


# ── HARDWARE & NETWORK ────────────────────────────────────────────────────────
# UDP port that ESP32 nodes send raw CSI frames to
AGGREGATOR_UDP_PORT=5005

# HTTP + WebSocket port for the Rust aggregator
AGGREGATOR_HTTP_PORT=3000

# WebSocket URI the inference engine reads from (must match AGGREGATOR_HTTP_PORT)
AGGREGATOR_WS_URI=ws://localhost:3000/ws

# Port the inference engine serves the dashboard and API on
INFERENCE_WS_PORT=8765

# Compute device: auto | cuda | mps | cpu
INFERENCE_DEVICE=auto

# Sync window before flushing a bundle (milliseconds)
AGGREGATOR_SYNC_WINDOW_MS=50

# Log level for the Rust aggregator
RUST_LOG=info

# Allowed CORS origins for the dashboard (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080,http://127.0.0.1:8000,http://127.0.0.1:8080

# Approx. room area in m² (used by crowd density module)
ROOM_AREA_M2=25.0


# ── SECURITY ──────────────────────────────────────────────────────────────────
# Set to "production" to enforce strict checks at startup
ECHOPOSE_ENV=development

# Fernet key for encrypting session data at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ECHOPOSE_SESSION_KEY=

# SHA-256 hash of the ONNX model file (optional integrity check)
EXPECTED_ONNX_HASH=

# Prometheus metrics port
METRICS_PORT=9090


# ── COMMERCIAL LICENSE ────────────────────────────────────────────────────────
# Purchase a license at https://echopose.io/license
#
# Tiers:
#   Community    — free, basic analytics + HA + Matter + alerts
#   Professional — + fast adapt, gait biometrics  (EP-PR-...)
#   Enterprise   — + full tactical suite          (EP-EN-...)
#   Defense      — + weapon detection, classified (EP-DF-...)
#
# ECHOPOSE_LICENSE_KEY=
#
# Set to "enforced" to gate licensed features (use in production deployments)
