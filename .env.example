# ==============================================================================
# EchoPose — Environment Configuration
# Copy this file to .env and fill in any blank values before deploying.
# ==============================================================================

# ── Node Mesh ─────────────────────────────────────────────────────
# How many ESP32 nodes the mesh expects before assuming full health
EXPECTED_NODES=3

# ── Rust Aggregator ───────────────────────────────────────────────
# Port for raw UDP frames from ESP32s
AGGREGATOR_UDP_PORT=5005
# Port for the REST API and WebSocket broadcast
AGGREGATOR_HTTP_PORT=3000
# Sync window before flushing a frame (milliseconds)
AGGREGATOR_SYNC_WINDOW_MS=50
# Log level: trace | debug | info | warn | error
RUST_LOG=info
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# ── Python Inference ──────────────────────────────────────────────
# WebSocket URI the inference engine connects to (must match AGGREGATOR_HTTP_PORT)
AGGREGATOR_WS_URI=ws://localhost:3000/ws
# Port for the inference engine to broadcast processed skeletons
INFERENCE_WS_PORT=8765
# Device: cuda | mps | cpu | auto
INFERENCE_DEVICE=auto

# ── Security (REQUIRED before production deployment) ──────────────
# API key for authenticated endpoints (X-EchoPose-Token header)
ECHOPOSE_API_TOKEN=
# Fernet key for session data encryption at rest
ECHOPOSE_SESSION_KEY=

# ── Gateway ───────────────────────────────────────────────────────
INFERENCE_GATEWAY_PORT=8765

# ── Model Integrity ──────────────────────────────────────────────
# SHA-256 hash of the ONNX model file (optional, enforced if set)
EXPECTED_ONNX_HASH=
