# ── Aggregator (Rust) ──────────────────────────────────────────────
AGGREGATOR_HTTP_PORT=3000
AGGREGATOR_UDP_PORT=5005
AGGREGATOR_SYNC_WINDOW_MS=50
EXPECTED_NODES=3
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# ── Inference (Python) ────────────────────────────────────────────
AGGREGATOR_WS_URI=ws://aggregator:3000/ws
INFERENCE_WS_PORT=8765
INFERENCE_DEVICE=auto

# ── Security ──────────────────────────────────────────────────────
ECHOPOSE_API_TOKEN=change_me_in_production
ECHOPOSE_SESSION_KEY=

# ── Gateway ───────────────────────────────────────────────────────
INFERENCE_GATEWAY_PORT=8765

# ── Model Integrity ──────────────────────────────────────────────
EXPECTED_ONNX_HASH=
