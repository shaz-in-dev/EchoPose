[Unit]
Description=EchoPose High-Throughput Async Inference (server_v2)
After=network.target aggregator.service

[Service]
Type=simple
User=rfmesh
WorkingDirectory=/opt/rf-mesh/inference
EnvironmentFile=/opt/rf-mesh/.env
Environment="PATH=/opt/rf-mesh/inference/venv/bin:$PATH"
ExecStart=/opt/rf-mesh/inference/venv/bin/gunicorn server_v2:app -w 1 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:${INFERENCE_WS_PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
